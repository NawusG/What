function PlayTime()
    for i,v in pairs(Play) do
        local Stat = v:WaitForChild("Stat")
        if Stat and v.Name == "Stat" then
            for _,child in pairs(Stat:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ":") then
                        return child.Text
                    end
                end
            end
        end
    end
end
local Time = PlayTime()

function DamageNum()
    for i,v in pairs(Play) do
        local Stat = v:WaitForChild("Stat")
        if Stat and v.Name == "Stat"
            for _,child in pairs(Stat:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ",") then
                        return child.Text
                    end
                end
            end
        end
    end
end
