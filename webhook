function PlayTime()
    for i,v in pairs(Play) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, "00:") then
                        return child.Text
                    end
                end
            end
        end
    end
end
local Time = PlayTime()

function DamageNum()
    for i,v in pairs(Players.LocalPlayer.PlayerGui.GameUI.MissionResultFrame.Main.Content.Description.Content.Stats.frame:GetChildren()) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ",") then
                        return child.Text
                    end
                end
            end
        end
    end
end
