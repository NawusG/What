task.spawn(function()
    while AutoCard and _G.Auto do
        task.wait(.1)
        local CardFound = {}
        if plrgui.GameUI.Paths.Enabled == true then
            for _,card in pairs(plrgui.GameUI.Paths.PathSelection.Cards:GetChildren()) do
                if card.Name == "Card" then
                    local CardCount = card.LayoutOrder
                    local Top = card:FindFirstChild("TopTitle")
                    local Rare = card:FindFirstChild("Rarity")
                    local Title = card:FindFirstChild("Title")
                    local Des = card:FindFirstChild('Text')
                    if Top then
                        local v_text = Top:FindFirstChild("Text")
                        if v_text then
                            local Class = v_text.Text
                            local Name = Title.Text
                            table.insert(CardFound, {
                                CardNum = CardCount,
                                Class = Class,
                                Title = Name,
                                Rare = Rare.Text,
                                Des = Des.Text,
                                Priorities = Priority[Name]
                            })
                        end
                    end
                end
            end
        end

        if #CardFound > 0 and #CardFound < 5 then
            task.wait()
            table.sort(CardFound, function(a, b)
                return a.Priorities < b.Priorities
            end)
            local select = CardFound[1]
            if select then 
                print("The best card is", select.CardNum, select.Title, select.Rare, select.Class, "RarityNum = " .. select.Priorities)
                knit.Services.BlessingService.RE.GetNewBlessing:FireServer(select.CardNum)
                task.wait()
                continue
            end
        elseif #CardFound >= 5 then
            for _,check in pairs(CardFound) do
               if check.Rare == "[Path]" and check.Title == "Magic's Manifest" then
                    print("Check Path : ", check.CardNum, check.Title)
                    knit.Services.BlessingService.RE.GetNewPath:FireServer(check.CardNum)
                    task.wait()
                    break
               end
            end
        end
    end
end)
