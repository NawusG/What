_G.Auto = true
local Replica = game:GetService("ReplicatedStorage")
local Package = Replica.Packages
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
task.spawn(function()
    while _G.Auto do 
        task.wait(1)
        local CardFound = {}
        if Players.LocalPlayer.PlayerGui.GameUI.Paths.Enabled == true then
            for i,v in pairs(Players.LocalPlayer.PlayerGui.GameUI.Paths.PathSelection.Cards:GetChildren()) do
                if v.Name == "Card" then
                    local CardNum = v.LayoutOrder
                    local Top = v:FindFirstChild("TopTitle")
                    local Rare = v:FindFirstChild("Rarity")
                    local Title = v:FindFirstChild("Title")
                    local Des = v:FindFirstChild('Text')
                    if Top then
                        local v_text = Top:FindFirstChild("Text")
                        if v_text then
                            local Class = v_text.Text
                            local Name = Title.Text
                            table.insert(CardFound, {
                                CardNum = v.LayoutOrder,
                                Class = Class,
                                Title = Name,
                                Rare = Rare.Text,
                                Des = Des.Text,
                            Priorities = Priority[Name]
                            })
                        end
                    end
                end
            end
        end


        
        if #CardFound > 0 and #CardFound < 5 then
            for leg,kaw in pairs(CardFound) do
                print(leg, "Name:", kaw.Title)
            end
        end
        if #CardFound > 0 and #CardFound < 5 then
            print("Found :", #CardFound)
            print("Folder is sorting !!!")
            table.sort(CardFound, function(a, b)
                return a.Priorities < b.Priorities
            end)
            local select = CardFound[1]
            if select then 
                print("The best card is", select.CardNum, select.Title, select.Rare, select.Class, "RarityNum = " .. select.Priorities)
                Package._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.BlessingService.RE.GetNewBlessing:FireServer(select.CardNum)
            end
        if #CardFound >= 5 then
            Package._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.BlessingService.RE.GetNewPath:FireServer(4)
        end
    end
end)
