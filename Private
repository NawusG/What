--- Calculate Play Time ---

function PlayTime()
    for i,v in pairs(plrgui.GameUI.MissionResultFrame.Main.Content.Description.Content.Stats.frame:GetChildren()) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ":") then
                        return child.Text
                    end
                end
            end
        end
    end
end


--- Calculate Takedowns ---

function Kill()
    return plrgui.GameUI.HUD.StageInfos.Infos.Takedowns.Value.Text
end

function SaveTakedown()
    return tostring(Kill()) or 0
end


--- Calculate DamageNum ---

function DamageNum()
    for i,v in pairs(plrgui.GameUI.MissionResultFrame.Main.Content.Description.Content.Stats.frame:GetChildren()) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ",") then
                        return child.Text
                    end
                end
            end
        end
    end
end

