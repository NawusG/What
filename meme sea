local NearQuest = {}
function GetNear(mon)
    local nearest = math.huge
    local right = nil
    for i,v in pairs(AllQuests) do
        local MonSpawn = Workspace.Location.Enemy_Location[mon]
        local ins = v.QuestCFrame
        local dis = (MonSpawn.Position - ins.Position).Magnitude
        if dis < nearest then
            nearest = dis
            right = ins
        end
    end
    TweenTo(right, 150)
end
    

