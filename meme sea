function CheckMonSpawn(mon)
    local MonSpawn = Workspace.Location.Enemy_Location[mon]
    local dis = (RootPart.Position - MonSpawn.Position).Magnitude
    if dis > 350 then
        TweenTo(MonSpawn.CFrame * CFrame.new(0, 20, 0), 200)
        return "success"
    end
    return "In range"
end

function UpStat(stat)
    local SkillPoint = plrdata.SkillPoint.Value
    local MeleeLvl = plrdata.MeleeLevel.Value
    local DefenseLvl = plrdata.DefenseLevel.Value
    local SwordLvl = plrdata.SwordLevel.Value
    local PowerLevel = plrdata.MemePowerLevel.Value
    if SkillPoint > 0 then     
        local args = {{Target = stat, Action = "UpgradeStats", Amount = 1}}
        ReplicatedStorage.OtherEvent.MainEvents.StatsFunction:InvokeServer(unpack(args))
    end
end

function UpStatKatan()
    local SkillPoint = plrdata.SkillPoint.Value
    local MeleeLvl = plrdata.MeleeLevel.Value
    local DefenseLvl = plrdata.DefenseLevel.Value
    local SwordLvl = plrdata.SwordLevel.Value
    local PowerLevel = plrdata.MemePowerLevel.Value
    if SkillPoint > 0 and DefenseLvl < 150 then
        local args = {{Target = "SwordLevel",Action = "UpgradeStats",Amount = 1}}
        ReplicatedStorage.OtherEvent.MainEvents.StatsFunction:InvokeServer(unpack(args))
        local args1 = {{Target = "DefenseLevel",Action = "UpgradeStats",Amount = 1}}
        ReplicatedStorage.OtherEvent.MainEvents.StatsFunction:InvokeServer(unpack(args1))
    else
        local args = {{Target = "SwordLevel", Action = "UpgradeStats", Amount = 1}}
        ReplicatedStorage.OtherEvent.MainEvents.StatsFunction:InvokeServer(unpack(args))
    end
end


