local Location = Workspace.Location
local QuestLocation = Location.QuestLocaion

function TweenTo(EndPoint, Speed)
    if not Character then 
        return 
    end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not RootPart then 
        return 
    end
    if Humanoid.Health <= 0 then 
        return
    end
    local Distance = (RootPart.Position - EndPoint.Position).Magnitude
    local Time = Distance / Speed
    local TweenInfo = TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local Tween = TweenService:Create(RootPart, TweenInfo, {CFrame = EndPoint})
    Tween:Play()
    Tween.Completed:Wait()
    RongPart()
end

function CheckLvl()
    local lvl = plrdata.Level.Value
    if lvl < 50 then
        return 1
    end
    if lvl < 1700 and lvl >= 1600 then
        return 31
    end
    if lvl >= 1700 then
        return math.floor(lvl / 50) - 1
    end
    return math.floor(lvl / 50) + 1
end

local SkipIns = { 9, 12, 15, 19, 23, 29, 32 }
function SkipBoss()
    local GetLvl = CheckLvl()
    if table.find(SkipIns, GetLvl) then
        return GetLvl - 1
    end
    return CheckLvl()
end

local OldLevel = SkipBoss()
function ChangeQuest()
    if OldLevel ~= SkipBoss() then
        local args = { "Abandon_Quest", { QuestSlot = "QuestSlot1" }}
        ReplicatedStorage.OtherEvent.QuestEvents.Quest:FireServer(unpack(args))
        OldLevel = SkipBoss()
    end
end

AllQuests = {}
for _,Quest in pairs(QuestLocation:GetChildren()) do
    table.insert(AllQuests, { QuestCFrame = Quest.CFrame, QuestName = tonumber(string.match(Quest.Name, "%d+")) })
end

function CheckQuestCFrame()
    for i,v in pairs(AllQuests) do
        local Skip = SkipBoss()
        if Skip == v.QuestName then
            return v.QuestCFrame
        end
    end
end

function GetQuest()
    local QuestPrompt = Workspace.NPCs.Quests_Npc
    for _,Quest in pairs(QuestPrompt:GetChildren()) do
        local BlockQuest = Quest:FindFirstChild("Block")
        local QuestPrompt = BlockQuest.QuestPrompt
        local Dis = (RootPart.Position - BlockQuest.Position).Magnitude
        if Dis < 20 then
            fireproximityprompt(QuestPrompt)
            return
        end
    end
    return
end

function TpQuest()
    if PlayerGui.QuestGui.Holder.QuestSlot1.Visible == false then
        repeat
            TweenTo(CheckQuestCFrame() * CFrame.new(0 , 15, 0) * CFrame.Angles(math.rad(-90), 0, 0), 100)
            task.wait(.2)
            GetQuest()
        until PlayerGui.QuestGui.Holder.QuestSlot1.Visible == true
            return "success"
    end 
    return false
end

