_G.Auto = not _G.Auto
repeat task.wait()
until game:IsLoaded()
local Replica = game:GetService("ReplicatedStorage")
local Package = Replica.Packages
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

function Placeunit(unit, cf)
    Package._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.TowerService.RF.PlaceUnit:InvokeServer(unit, cf * CFrame.Angles(-0, 0, -0))
end

function UpAll()
        for _,monbyte in pairs(Workspace.Ignore.Units:GetChildren()) do
            if #monbyte.Name > 10 then
                Package._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.TowerService.RF.UpgradeUnit:InvokeServer(monbyte.Name)
            end
        end
    end

    function replay()
        game:GetService("ReplicatedStorage").Packages._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.WaveService.RE.VoteReplay:FireServer()
    end

    task.spawn(function()
    while _G.Auto do task.wait()
        local Wave = Workspace:GetAttribute("Wave")
        if Players.LocalPlayer.PlayerGui.GameUI.HUD.Vote.Visible == true then
            Package._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.WaveService.RF.Vote:InvokeServer(true)
            task.wait(2)
            game:GetService("ReplicatedStorage").Packages._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.BlessingService.RE.GetNewPath:FireServer(4)
            task.wait(2)
            Placeunit(3, CFrame.new(-15.845394134521484, 299.98406982421875, -233.03311157226562))
            continue
        end
        if game:GetService("Players").LocalPlayer.PlayerGui.GameUI.MissionResultFrame.Main.Visible == true then
            replay()
            task.wait(2)
            continue
        end
        task.wait(.3)
        Placeunit(1, CFrame.new(-18.358205795288086, 299.98406982421875, -243.60015869140625))
        task.wait(.3)
        Placeunit(6, CFrame.new(-12.740373611450195, 299.98406982421875, -244.00558471679688))
        task.wait(.3)
        if Wave > 7 then
            Placeunit(5, CFrame.new(-17.376726150512695, 299.98406982421875, -243.16683959960938))
        end
        task.wait(.3)
        UpAll()
        task.wait(.3)
        if Wave > 10 and Wave <= 12 then
            Placeunit(4, CFrame.new(-20.973888397216797, 299.98406982421875, -268.64276123046875))
        end
    end
end)


