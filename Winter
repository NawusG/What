local seen = {}
local s = {}

function GetReward()
    local Rewards = plrgui:FindFirstChild("Rewards")
    if #Rewards:GetChildren() <= 0 then
        return
    end
    task.wait(.3)
    local ViewReward = Rewards:FindFirstChild("ViewReward")
    if not ViewReward then
        return
    end
    local UnitInformation = ViewReward:WaitForChild("UnitInformation")
    local HoverFrame = UnitInformation:WaitForChild("HoverFrame")
    local Frame = HoverFrame:WaitForChild("Frame")
    local itemName = Frame:WaitForChild("UnitName").Text
    local RareName = Frame:WaitForChild("Rarity").Text
    local Stats = Frame:WaitForChild("Stat"):WaitForChild("Stat")
    local Amount = Stats.Text
    task.wait(.1)
    print("item is "..itemName, Amount, "Rarity : "..RareName)
    local key = itemName .. "|" .. RareName .."|" .. Amount
    print(key)
    if not seen[key] then
        print("Set key:", key)
        seen[key] = true
        table.insert(s, {
            item = itemName,
            Rarity = RareName,
            Count = Amount
        })
    end
end

local function FormatRewards(list)
    local text = ""
    for _, v in ipairs(list) do
        text = text .. "Item: " .. v.item .. " | Count: " .. v.Count .. " | Rarity: " .. v.Rarity .. "\n"
    end
    return text
end

function Webhook(Result)
    if typeof(url) ~= "string" or url == "" then
        return
    end
    local Damage = tostring(DamageNum() or 0)
    local Time = tostring(PlayTime() or "0:00")
    local LocalName = tostring(Players.LocalPlayer.Name)
    local Level = tostring(Workspace[LocalName].HumanoidRootPart.BillboardGui.LevelAmount.Text)
    local VirtualTokens = Players.LocalPlayer:GetAttribute("VirtualTokens")
    local Gems = Players.LocalPlayer:GetAttribute("Gems")
    local Spirit = Players.LocalPlayer:GetAttribute("SpiritSouls")
    local response = Request(
    {
        Url = url,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode({
            ["content"] = "",
            ["embeds"] = {{
                ["title"] = "End Round ! ",
                ["description"] = Players.LocalPlayer.DisplayName.." has finished the round.",
                ["type"] = "rich",
                ["color"] = tonumber("A6DC41", 16),
                ["fields"] = {
                    {
                        ["name"] = "Player Info",
                        ["value"] = "🐼 Player : ".. tostring(LocalName).." | Level : ".. tostring(Level),
                        ["inline"] = false
                    },
                    {
                        ["name"] = "Info",
                        ["value"] = "🍀 Total Virtual Tokens : ".. tostring(VirtualTokens).."\n💎 Total Gems : ".. tostring(Gems).."\nTotal Souls : " .. tostring(Spirit),
                        ["inline"] = false
                    },
                    {
                        ["name"] = "Round Info",
                        ["value"] = "Round Time : ".. Time .."\nTotal Damage : ".. Damage .. "\nTotal Items: " .. Result,
                        ["inline"] = false
                    } 
                }
            }}
        })
    }
    )
table.clear(s)
