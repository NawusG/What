--- Calculate Play Time ---

function PlayTime()
    for i,v in pairs(plrgui.GameUI.MissionResultFrame.Main.Content.Description.Content.Stats.frame:GetChildren()) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ":") then
                        return child.Text
                    end
                end
            end
        end
    end
end

--- Calculate DamageNum ---

function DamageNum()
    for i,v in pairs(plrgui.GameUI.MissionResultFrame.Main.Content.Description.Content.Stats.frame:GetChildren()) do
        if v.Name == "Stat" then
            for _,child in pairs(v:GetChildren()) do
                if child:IsA("TextLabel") then
                    if string.match(child.Text, ",") then
                        return child.Text
                    end
                end
            end
        end
    end
end




function Placeunit(unit, cf)
    knit.Services.TowerService.RF.PlaceUnit:InvokeServer(unit, cf * CFrame.Angles(-0, 0, -0))
end

