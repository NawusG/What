local seen = {}
local s = {}

function GetReward()
    local Rewards = plrgui:FindFirstChild("Rewards")
    if #Rewards:GetChildren() <= 0 then
        return
    end
    task.wait(.3)
    local ViewReward = Rewards:FindFirstChild("ViewReward")
    if not ViewReward then
        return
    end
    local UnitInformation = ViewReward:WaitForChild("UnitInformation")
    local HoverFrame = UnitInformation:WaitForChild("HoverFrame")
    local Frame = HoverFrame:WaitForChild("Frame")
    local itemName = Frame:WaitForChild("UnitName").Text
    local RareName = Frame:WaitForChild("Rarity").Text
    local Stats = Frame:WaitForChild("Stat"):WaitForChild("Stat")
    local Amount = Stats.Text
    task.wait(.1)
    --print("item is "..itemName, Amount, "Rarity : "..RareName)
    local key = itemName .. "|" .. RareName .."|" .. Amount
    --print(key)
    if not seen[key] then
        --print("Set key:", key)
        seen[key] = true
        table.insert(s, {
            item = itemName,
            Rarity = RareName,
            Count = Amount
        })
    end
end

local function FormatRewards(list)
    local text = ""
    for _, v in ipairs(list) do
        text = text .. "💼 | Item: " .. v.item .. " | " .. v.Count .. " | Rarity: " .. v.Rarity .. "\n"
    end
    return text
end

