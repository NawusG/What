function nelleAttack()
    for _,MyUnit in pairs(Workspace.Ignore.Units:GetChildren()) do
        if string.len(MyUnit.Name) < 10 then 
            continue 
        end
        for _,NameUnit in pairs(MyUnit:GetChildren()) do
            if NameUnit:IsA("Model") and NameUnit.Name == "Adult" then
                local ThisNelle = NameUnit.Parent.Name
                if Workspace.Ignore.Units[ThisNelle].Adult.NellSword.blade.Transparency == 1 then
                    knit.Services.TowerService.RE.UseAbility:FireServer(ThisNelle, 1)
                    return true
                end
            end
        end
    end
    return false
end

